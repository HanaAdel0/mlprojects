# Demo
# --------------------------------------------------------------------------- #
if __name__ == "__main__":
    try:
        emb = SentenceTransformerEmbedder()
        print("using", emb.name)
        kw = {}
    except Exception:
        emb = HashingEmbedder()
        print("sentence-transformers not available -> lexical HashingEmbedder fallback")
        kw = dict(match_threshold=0.30, duplicate_threshold=0.80, absorb_threshold=0.45)

    idx = CategoryIndex("categories.db" if False else ":memory:", emb, **kw)
    idx.seed()
    print(f"{len(idx)} categories seeded\n")

    for t, nm in [
        ("billing payment charged twice", None),
        ("delivery of my package is late", None),
        ("security problem with my account", None),
        ("Do you sell gift cards?", "Gift cards"),   # nothing fits -> new category
        ("Where can I buy a gift card?", None),      # should now hit the new one
        ("help me write my resume cv", None),
        ("python script to parse csv", None),
        ("sql query with joins", None),
        ("build a powerbi dashboard", None),
        ("c++ pointers and memory", None),
        ("translate this into french", None),
    ]:
        a = idx.assign(t, new_name=nm)
        print(f"{a.status:8} {a.score:.2f}  {a.category.name!r:24} <- {t}")

    print("\ncategories:", [c.name for c in idx.categories()])
    print("possible duplicates:", [(a.name, b.name, round(s, 2)) for a, b, s in idx.find_duplicates(0.6)])
