
from __future__ import annotations

import re
import sqlite3
import threading
import time
import zlib
from dataclasses import dataclass
from typing import Optional, Protocol, Sequence

import numpy as np


# --------------------------------------------------------------------------- #
# Embedders
# --------------------------------------------------------------------------- #
class Embedder(Protocol):
    name: str  # stored in the DB; vectors from different models never mix
    dim: int

    def embed(self, texts: Sequence[str]) -> np.ndarray:
        """Return an (n, dim) float32 array of L2-normalised vectors."""


def _unit(x: np.ndarray) -> np.ndarray:
    return x / np.maximum(np.linalg.norm(x, axis=-1, keepdims=True), 1e-12)


def _clean(text: str) -> str:
    return re.sub(r"\s+", " ", text.strip())


class SentenceTransformerEmbedder:
    """Real semantic embeddings (pip install sentence-transformers)."""

    def __init__(self, model_name: str = "sentence-transformers/all-MiniLM-L6-v2"):
        from sentence_transformers import SentenceTransformer

        self._model = SentenceTransformer(model_name)
        self.name = model_name
        self.dim = int(self._model.get_sentence_embedding_dimension())

    def embed(self, texts: Sequence[str]) -> np.ndarray:
        v = self._model.encode(list(texts), normalize_embeddings=True)
        return np.asarray(v, dtype=np.float32)


class HashingEmbedder:
    """Dependency-free fallback: signed hashed character n-grams + words."""

    def __init__(self, dim: int = 1024, ngrams=(3, 4, 5)):
        self.dim, self.ngrams = dim, ngrams
        self.name = f"hashing-{dim}-{''.join(map(str, ngrams))}"

    def embed(self, texts: Sequence[str]) -> np.ndarray:
        out = np.zeros((len(texts), self.dim), dtype=np.float32)
        for i, t in enumerate(texts):
            s = " " + _clean(t).lower() + " "
            feats = [s[j:j + n] for n in self.ngrams for j in range(len(s) - n + 1)]
            feats += ["w:" + w for w in s.split()]
            for f in feats:
                h = zlib.crc32(f.encode())
                out[i, h % self.dim] += 1.0 if (h >> 31) & 1 else -1.0
        return _unit(out)


# --------------------------------------------------------------------------- #
# Data types
# --------------------------------------------------------------------------- #
@dataclass
class Category:
    id: int
    name: str
    count: int  # how many vectors (name + absorbed examples) back the centroid


@dataclass
class Match:
    category: Category
    score: float


@dataclass
class Assignment:
    status: str                 # "matched" | "created" | "no_match"
    category: Optional[Category]
    score: float                # cosine of best candidate (1.0 for created)
    ambiguous: bool             # runner-up was within `ambiguity_margin`
    candidates: list[Match]


def _key(name: str) -> str:
    return _clean(name).casefold()


